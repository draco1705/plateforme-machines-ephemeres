import argparse
import requests
import os

API_URL = os.getenv("LABHACKER_API_URL", "http://localhost:8000")
TOKEN_FILE = os.path.expanduser("~/.labhacker_token")


def get_token():
    if os.path.exists(TOKEN_FILE):
        with open(TOKEN_FILE, "r") as f:
            return f.read().strip()
    return None


def set_token(token):
    with open(TOKEN_FILE, "w") as f:
        f.write(token)


def login(args):
    print("Logging in...")
    resp = requests.post(
        f"{API_URL}/users/login",
        data={"username": args.username, "password": args.password},   # ← data + /users/login
    )
    if resp.status_code == 200:
        set_token(resp.json().get("access_token"))                     # ← access_token
        print("Logged in successfully!")
    else:
        print(f"Login failed: {resp.status_code} {resp.text}")


def logout(args):
    if os.path.exists(TOKEN_FILE):
        os.remove(TOKEN_FILE)
        print("Logged out successfully!")
    else:
        print("Not logged in.")


def reserve(args):
    token = get_token()
    if not token:
        print("Not logged in. Run 'labcli login <email> <password>' first.")
        return

    headers = {"Authorization": f"Bearer {token}"}
    data = {                                                            # ← schema đúng
        "machine_id": args.machine_id,
        "cpu": args.cpu,
        "ram_mb": args.ram_mb,
        "duration_minutes": args.duration_minutes,
    }
    resp = requests.post(f"{API_URL}/reservations", json=data, headers=headers)
    if resp.status_code == 201:
        res = resp.json()
        print(f"Reservation successful! ID: {res['id']}, Status: {res['status']}")
    else:
        print(f"Failed to reserve: {resp.status_code} {resp.text}")


def list_res(args):
    token = get_token()
    if not token:
        print("Not logged in.")
        return

    headers = {"Authorization": f"Bearer {token}"}
    resp = requests.get(f"{API_URL}/reservations", headers=headers)
    if resp.status_code == 200:
        reservations = resp.json()
        if not reservations:
            print("No reservations.")
            return

        print(f"{'ID':<6} | {'Machine':<8} | {'Worker':<8} | {'Status':<12} | URL")
        print("-" * 90)
        for r in reservations:
            print(f"{r['id']:<6} | {r.get('machine_id', '?'):<8} | "
                  f"{r.get('worker_id') or 'N/A':<8} | {r['status']:<12} | "
                  f"{r.get('access_url') or '-'}")
    else:
        print(f"Failed to fetch: {resp.status_code} {resp.text}")


def delete_res(args):
    token = get_token()
    if not token:
        print("Not logged in.")
        return

    headers = {"Authorization": f"Bearer {token}"}
    resp = requests.delete(f"{API_URL}/reservations/{args.id}", headers=headers)
    if resp.status_code == 204:                                         # ← 204, không phải 200
        print(f"Reservation #{args.id} deleted.")
    else:
        print(f"Failed to delete: {resp.status_code} {resp.text}")


def main():
    parser = argparse.ArgumentParser(description="LabHacker CLI")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # login
    login_p = subparsers.add_parser("login", help="Login to the API")
    login_p.add_argument("username", help="Email address")
    login_p.add_argument("password")

    # logout
    subparsers.add_parser("logout", help="Remove stored token")

    # reserve
    reserve_p = subparsers.add_parser("reserve", help="Create a reservation")
    reserve_p.add_argument("--machine-id", type=int, required=True)
    reserve_p.add_argument("--cpu", type=int, default=1)
    reserve_p.add_argument("--ram", type=int, default=512, dest="ram_mb")
    reserve_p.add_argument("--duration", type=int, default=30, dest="duration_minutes")

    # list
    subparsers.add_parser("list", help="List reservations")

    # delete
    delete_p = subparsers.add_parser("delete", help="Cancel a reservation")
    delete_p.add_argument("id", type=int)

    args = parser.parse_args()

    if args.command == "login":
        login(args)
    elif args.command == "logout":
        logout(args)
    elif args.command == "reserve":
        reserve(args)
    elif args.command == "list":
        list_res(args)
    elif args.command == "delete":
        delete_res(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()